# URL pública del sitio (para metadatos y Open Graph). En Vercel, pon tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: token de GitHub (solo lectura, sin permisos) para no chocar con el límite
# de 60 peticiones/hora de la API pública. Crea uno en github.com/settings/tokens
GITHUB_TOKEN=
